{
  "name": "yitab",
  "version": "1.2.0",
  "description": "YiTab 一签 — Chrome 标签页 / 书签效率工具套件",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt --browser firefox",
    "build": "wxt build",
    "zip": "wxt build && wxt zip",
    "compile": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "screenshot": "node scripts/capture-previews.mjs",
    "store-assets": "node scripts/generate-store-assets.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "antd": "^5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@wxt-dev/module-react": "^1.1.3",
    "typescript": "^5.7.0",
    "wxt": "^0.20.0"
  }
}
